# Copy to .env and fill secrets. Ports here are the compose-level knobs;
# each service also reads the full HARNESS_API_BIND / MCP_LINUX_BIND at runtime.
# Compose keeps everything on the compose network (no host ports published) —
# localhost-only today; tune the BIND vars when you expose via VPN (SPEC §7).
HARNESS_API_PORT=8080
MCP_LINUX_PORT=9001

# Required — one per adapter. The "telegram:" entry's secret must match
# TELEGRAM_HARNESS_API_TOKEN below exactly (same secret, two names because
# each side owns its own env var per SPEC §5.7/§7).
HARNESS_API_CLIENT_TOKENS=cli:change-me,telegram:change-me-too

# Required for the telegram-adapter service.
TELEGRAM_BOT_TOKEN=change-me
ALLOWED_CHAT_IDS=123456789
TELEGRAM_HARNESS_API_TOKEN=change-me-too

# Optional overrides (see SPEC §5.7). When set they win over the PORT vars:
# HARNESS_API_BIND=0.0.0.0:8080
# MCP_LINUX_BIND=0.0.0.0:9001
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b

# Securo backend (M2) — required. Securo is external, not a compose service;
# these are folded into the harness's MCP_SERVERS entry at compose-interpolation
# time (see compose.yaml), never passed to the harness as SECURO_*-named vars
# themselves — the harness stays backend-agnostic (AGENTS.md #6). No workspace
# var needed: the bearer token's ws_id claim scopes every call server-side —
# confirmed live, no Securo tool takes a workspace parameter.
SECURO_MCP_URL=https://host:port/mcp
SECURO_MCP_AUTH=change-me

# M3 (SPEC §11, §12.1, §12.2) — optional overrides; the compose defaults
# already point at the mounted /data volume so these survive a container
# recreate. DESTRUCTIVE_TOOLS is now an operator override on top of the
# model-driven classifier (crates/harness/src/policy.rs), not the primary
# mechanism — most deployments never need to set it. TOOL_POLICY_PATH is a
# plain, hand-editable JSON file: set "source":"operator" on an entry to pin
# it against automatic reclassification. TRANSCRIPT_LOG_PATH is a separate,
# hash-chained record of every conversation/tool-call event (not just
# executed writes, which is all AUDIT_LOG_PATH covers) — see SPEC §12.2 for
# why the two are deliberately different files.
# TOOL_POLICY_PATH=/data/arno-tool-policy.json
# AUDIT_LOG_PATH=/data/arno-audit.jsonl
# TRANSCRIPT_LOG_PATH=/data/arno-transcript.jsonl
# TOOL_POLICY_RETRY_S=300
# DESTRUCTIVE_TOOLS=securo.some_tool
