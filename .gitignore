# Build artifacts
/target

# Secrets — never commit real credentials; .env.example stays tracked
.env
*.local.env

# Bind-mounted harness state (M3, AGENTS.md #7 exceptions) — tool policy,
# hash-chained audit log, transcript. Contains real finance data.
/data
# Same three files, but at their config.rs default paths (./arno-*) — what
# you get running the harness natively without setting TOOL_POLICY_PATH /
# AUDIT_LOG_PATH / TRANSCRIPT_LOG_PATH.
/arno-tool-policy.json
/arno-audit.jsonl
/arno-transcript.jsonl

# Session-scoped scratch notes (see AGENTS.md workflow) — never meant for VCS
*.tmp.md

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
